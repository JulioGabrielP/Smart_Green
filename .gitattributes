# Auto detect text files and normalize line endings to LF in the repo
* text=auto

# Force LF for common source files
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.sh text eol=lf

# Windows-specific scripts should keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf

# Treat common binary files as binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.jar binary
*.so binary
*.dll binary
*.pdf binary

# Platform folders (treat files inside as text by default)
android/** text eol=lf
ios/** text eol=lf
linux/** text eol=lf
macos/** text eol=lf
windows/** text eol=lf

# End of file
